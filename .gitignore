.DS_Store
*.swp
.env

# Local-only devnet: this machine's own running node (chain state, logs,
# specs generated by `ckb init`) is a disposable local artifact, not
# something to version -- `devnet-ops/` (the actual tool) is what's worth
# keeping.
/devnet/

# devnet-ops: throwaway devnet-only signing keys (no real funds, no real
# network -- still excluded on principle, so a key never ends up in git
# history) and the per-run JSON state files each step writes/reads, which
# are tied to one specific devnet instance's tx hashes and would just be
# stale/wrong noise in git.
/devnet-ops/target/
/devnet-ops/*_key.txt
/devnet-ops/deployed.json
/devnet-ops/registry.json
/devnet-ops/offer_guard.json
/devnet-ops/offer.json
/devnet-ops/reserve.json
/devnet-ops/deployed_always_success.json
# Testnet (and any other non-devnet) run's own state directory -- see
# CKB_DATA_DIR in devnet-ops/src/lib.rs's data_dir(). Real testnet key
# and tx-hash state, kept out of git the same way the devnet files are.
/devnet-ops/testnet_data/
